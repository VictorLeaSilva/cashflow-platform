# padroniza a formatação para reduzir diferenças entre ambientes
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.java]
indent_size = 2

[*.{xml,yml,yaml,json,md}]
indent_size = 2

[*.bat]
end_of_line = crlf
