{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxocaixa.com.br/contracts/events/lancamento-registrado.v1.schema.json",
  "title": "LancamentoRegistrado.v1",
  "description": "Fato financeiro registrado em Lançamentos (03 §4). tipoOriginal e referenciaLancamentoId existem se e somente se tipo = ESTORNO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "comercianteId",
    "lancamentoId",
    "tipo",
    "valor",
    "dataReferencia"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "LancamentoRegistrado"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "comercianteId": {
      "type": "string",
      "format": "uuid"
    },
    "lancamentoId": {
      "type": "string",
      "format": "uuid"
    },
    "tipo": {
      "enum": ["CREDITO", "DEBITO", "ESTORNO"]
    },
    "valor": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "dataReferencia": {
      "type": "string",
      "format": "date"
    },
    "tipoOriginal": {
      "enum": ["CREDITO", "DEBITO"]
    },
    "referenciaLancamentoId": {
      "type": "string",
      "format": "uuid"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "if": {
    "properties": {
      "tipo": {
        "const": "ESTORNO"
      }
    },
    "required": ["tipo"]
  },
  "then": {
    "required": ["tipoOriginal", "referenciaLancamentoId"]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": ["tipoOriginal"]
        },
        {
          "required": ["referenciaLancamentoId"]
        }
      ]
    }
  }
}
