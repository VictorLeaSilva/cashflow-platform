
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LancamentoRegistrado.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "lancamentoId",
    "tipo",
    "valor",
    "dataReferencia"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "LancamentoRegistrado"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "lancamentoId": {
      "type": "string",
      "format": "uuid"
    },
    "tipo": {
      "enum": ["CREDITO", "DEBITO", "ESTORNO"]
    },
    "valor": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "dataReferencia": {
      "type": "string",
      "format": "date"
    }
  }
}
