# Variáveis da infraestrutura local (deploy/docker-compose.yml).
# Copie para .env (ignorado pelo Git). Os valores abaixo são apenas para desenvolvimento local.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-local-superuser
LANCAMENTOS_OWNER_PASSWORD=troque-local-lancamentos-owner
LANCAMENTOS_APP_PASSWORD=troque-local-lancamentos-app
CONSOLIDADO_OWNER_PASSWORD=troque-local-consolidado-owner
CONSOLIDADO_APP_PASSWORD=troque-local-consolidado-app

# Portas no host
POSTGRES_PORT=5432
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
# Profile "observability" (T-032): Prometheus e Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Portas de gestão dos serviços (Actuator: health e prometheus, sem autenticação, só local).
# Se mudar, ajuste também os alvos em deploy/prometheus/prometheus.yml.
# LANCAMENTOS_MANAGEMENT_PORT=9081
# CONSOLIDADO_MANAGEMENT_PORT=9082

# Broker usado pelo publicador da outbox de Lançamentos (T-016). Opcional: sem ela, o serviço usa
# localhost:${KAFKA_PORT}.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
