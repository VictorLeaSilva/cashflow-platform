#!/usr/bin/env bash
# G1: segredos nos arquivos staged + formatação. Ativar com: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || {
    echo "✘ gitleaks encontrou possível segredo nos arquivos staged." >&2
    exit 1
  }
else
  echo "⚠ gitleaks não instalado: verificação local de segredos ignorada (instale: https://github.com/gitleaks/gitleaks)." >&2
fi

if [ -x ./mvnw ]; then
  ./mvnw -q spotless:check || {
    echo "✘ Formatação fora do padrão. Rode: ./mvnw spotless:apply" >&2
    exit 1
  }
fi
